# Leave unset in development (Vite proxies /api to backend).
# In production (e.g. Vercel frontend project), set to your BACKEND URL so login/API
# requests go to the API, not the frontend (otherwise you get 405 + HTML).
# Example: backend on s87z, frontend on bmvv -> set this on the bmvv project to s87z URL.
# VITE_API_URL=https://al-driven-learning-platform-s87z.vercel.app
