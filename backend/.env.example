PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_learning?schema=public"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=sk-your-openai-api-key
# If you get "401 Missing scopes: model.request": this key can't call the AI. If you don't have
# access to OpenAI settings, ask whoever gave you the key to enable scope "model.request" or provide an unrestricted key.
# Optional: override chat model if you get "403 Project does not have access to model"
# OPENAI_CHAT_MODEL=gpt-4o
